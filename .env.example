# Docker Compose environment. Use a unique password and an HTTPS hostname.
POSTGRES_DB=agentic_shop
POSTGRES_USER=agentic_shop
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://agentic_shop:replace-with-a-long-random-password@db:5432/agentic_shop
ENVIRONMENT=production
PUBLIC_URL=https://shop.example.com
COOKIE_SECURE=true
CURRENCY=USD
SESSION_HOURS=8
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_INPUT_PRICE=0
AI_OUTPUT_PRICE=0
AI_DAILY_TOKENS=50000
AI_MAX_ITERATIONS=4
META_ACCESS_TOKEN=
META_PHONE_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
